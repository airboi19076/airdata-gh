export default async function handler(req, res) {
  res.setHeader('Cache-Control', 'no-store');

  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed.' });
  }

  const apiKey = process.env.GEMINI_API_KEY;

  if (!apiKey) {
    return res.status(503).json({
      error: 'The AI assistant is not configured yet.'
    });
  }

  try {
    const messages = Array.isArray(req.body?.messages)
      ? req.body.messages.slice(-8)
      : [];

    const contents = messages
      .filter(item =>
        ['user', 'model'].includes(item.role) &&
        typeof item.text === 'string' &&
        item.text.trim().length > 0
      )
      .map(item => ({
        role: item.role,
        parts: [{ text: item.text.slice(0, 1500) }]
      }));

    if (
      contents.length === 0 ||
      contents[contents.length - 1].role !== 'user'
    ) {
      return res.status(400).json({
        error: 'Please enter a message.'
      });
    }

    const systemPrompt = `
You are In Scope AI, the customer-help assistant for AirData GH.

ONLY help with AirData GH:
- Registration, login and customer accounts.
- MTN data bundles and website prices.
- Ordering data bundles.
- Wallet and payment questions.
- Payment difficulties and customer support.

Use simple, friendly English. Keep replies brief.

IMPORTANT RULES:
- Politely reject questions unrelated to AirData GH.
- Never invent bundle prices. Ask customers to check the website.
- Never claim a payment, deposit or order succeeded without a verified system record.
- You cannot access customers' private accounts or transaction records.
- Never ask for passwords, PINs, OTPs or full card details.
- For problems requiring human support, direct customers to WhatsApp: 0548 206 175.
- Never pretend to perform actions on a customer's account.
`;

    const response = await fetch(
      'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=' +
        encodeURIComponent(apiKey),
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          systemInstruction: {
            parts: [{ text: systemPrompt }]
          },
          contents,
          generationConfig: {
            temperature: 0.4,
            maxOutputTokens: 350
          }
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      console.error('Gemini error:', data);
      return res.status(502).json({
        error: 'The assistant is temporarily unavailable. Please try again.'
      });
    }

    const answer = data.candidates?.[0]?.content?.parts
      ?.map(part => part.text || '')
      .join('')
      .trim();

    if (!answer) {
      return res.status(502).json({
        error: 'I could not prepare a reply. Please try again.'
      });
    }

    return res.status(200).json({ reply: answer });

  } catch (error) {
    console.error('In Scope AI error:', error);

    return res.status(500).json({
      error: 'Something went wrong. Please try again.'
    });
  }
}
